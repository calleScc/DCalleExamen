<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCalleExamen.LoginPage" Title="Login">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Image Source="logo.png" HeightRequest="100"/>
        <Label Text="LOGIN" TextColor="Red" FontSize="20"
               HorizontalOptions="Center"/>

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,2*" RowSpacing="10">
            <Label Text="Usuario" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="txtUsuario" Grid.Row="0" Grid.Column="1" Placeholder="Usuario"/>
            <Label Text="Contraseña" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="txtClave" Grid.Row="1" Grid.Column="1"
                   Placeholder="Contraseña" IsPassword="True"/>
        </Grid>

        <Button Text="Iniciar sesión" Clicked="OnLogin"
                Style="{StaticResource BotonPrincipal}"/>
    </VerticalStackLayout>
</ContentPage>