<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DCalleExamen.ResumenPage" Title="Resumen">
    <VerticalStackLayout Padding="15" Spacing="10">
        <Label x:Name="lblUsuario" HorizontalOptions="End"/>
        <Label Text="RESUMEN" Style="{StaticResource TituloVista}"/>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="*,*" RowSpacing="8">
            <Label Text="Nombre"        Grid.Row="0"/>
            <Label x:Name="lblNombre"   Grid.Row="0" Grid.Column="1"/>
            <Label Text="Apellido"      Grid.Row="1"/>
            <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1"/>
            <Label Text="Edad"          Grid.Row="2"/>
            <Label x:Name="lblEdad"     Grid.Row="2" Grid.Column="1"/>
            <Label Text="Fecha"         Grid.Row="3"/>
            <Label x:Name="lblFecha"    Grid.Row="3" Grid.Column="1"/>
            <Label Text="Ciudad"        Grid.Row="4"/>
            <Label x:Name="lblCiudad"   Grid.Row="4" Grid.Column="1"/>
            <Label Text="País"          Grid.Row="5"/>
            <Label x:Name="lblPais"     Grid.Row="5" Grid.Column="1"/>
            <Label Text="Monto inicial" Grid.Row="6"/>
            <Label x:Name="lblMonto"    Grid.Row="6" Grid.Column="1"/>
            <Label Text="Pago mensual"  Grid.Row="7"/>
            <Label x:Name="lblMensual"  Grid.Row="7" Grid.Column="1"/>
            <Label Text="Pago total"    Grid.Row="8"/>
            <Label x:Name="lblTotal"    Grid.Row="8" Grid.Column="1"/>
        </Grid>

        <Button Text="Volver" Clicked="OnVolver" Style="{StaticResource BotonPrincipal}"/>
    </VerticalStackLayout>
</ContentPage>